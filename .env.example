# Copy to .env.local and fill the Supabase values from `npx supabase status`.

# Public address of the app, used in the sign-in link sent with invites.
# The private instance sets its own address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API_URL in `npx supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# PUBLISHABLE_KEY in `npx supabase status` (safe in the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET_KEY in `npx supabase status`. Server only, bypasses RLS.
# Not used anywhere in the app yet; leave it empty.
SUPABASE_SECRET_KEY=

# Shows the component gallery at /dev/ui in a production build. Always on in
# `npm run dev`. Turn it on ("1") only in the demo (#23); never in production.
NEXT_PUBLIC_SHOW_DEV_UI=
